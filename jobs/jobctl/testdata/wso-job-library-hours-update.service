##### WSO job: library-hours-update #####
# generated by wso-jobctl gen-units; do not edit
[Unit]
Description=WSO job: library-hours-update - refresh library hours JSON
After=network-online.target

[Service]
Type=oneshot
User=wso
Group=wso
Environment=WSO_JOB_NAME=library-hours-update
Environment=WSO_JOB_UNIT=wso-job-library-hours-update.service
ExecStartPre=/opt/wso-go/wso-jobctl_linux record-start -config /opt/wso-go/config.yaml
ExecStart=/opt/wso-go/job-library-hours-update_linux -out /home/wso/wso/static/library.json
ExecStopPost=/opt/wso-go/wso-jobctl_linux record-finish -config /opt/wso-go/config.yaml
RuntimeMaxSec=600
MemoryMax=256M

[Install]
WantedBy=multi-user.target
