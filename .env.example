# Copy to .env for per-worktree local overrides (gitignored).
# Defaults match a single checkout with nothing else bound on these ports.
#
# COMPOSE_PROJECT_NAME defaults to the directory basename (e.g. wso-go-board).
# Set it only if you need a stable name across renames.
# COMPOSE_PROJECT_NAME=wso-go

MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379
TEST_MYSQL_HOST_PORT=3307
